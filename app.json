{
  "expo": {
    "name": "Glider",
    "slug": "GhostShieldMobile",
    "version": "1.0.0",
    "scheme": "glider",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.azymarch.glider",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "sandbag-sterling-leggings.ngrok-free.dev",
              "pathPrefix": "/"
            },
            {
              "scheme": "http",
              "host": "sandbag-sterling-leggings.ngrok-free.dev",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "react-native-compressor"
    ],
    "extra": {
      "eas": {
        "projectId": "7006ab11-c720-42d8-99b3-7bedb78d379a"
      }
    }
  }
}
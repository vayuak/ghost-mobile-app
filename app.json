{
  "expo": {
    "name": "WarnPack",
    "slug": "GhostShieldMobile",
    "version": "1.0.0",
    "scheme": "warnpack",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.azymarch.WarnPack",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.warnpack.com",
              "pathPrefix": "/post"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "react-native-compressor",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WarnPack uses your location only while the app is open, to show AirDrops within 100 m and to pin the ones you send. It is never used in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "WarnPack needs access to your photos so you can attach a photo or video to a scam warning or choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFB020"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "de8c57ac-7a3a-4402-810d-a13e41c526cc"
      }
    },
    "owner": "azymarch2"
  }
}
{
  "expo": {
    "name": "ViaCustos",
    "slug": "GhostShieldMobile",
    "version": "1.0.0",
    "scheme": "ViaCustos",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.azymarch.ViaCustos",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "letdown-citric-dividable.ngrok-free.dev",
              "pathPrefix": "/"
            },
            {
              "scheme": "http",
              "host": "letdown-citric-dividable.ngrok-free.dev",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-sqlite",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "react-native-compressor",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "de8c57ac-7a3a-4402-810d-a13e41c526cc"
      }
    },
    "owner": "azymarch2"
  }
}
